<Application x:Class="CutCraft.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:CutCraft.Wpf.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E" />
        <SolidColorBrush x:Key="PanelBackground" Color="#252526" />
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC" />
        <SolidColorBrush x:Key="TextLight" Color="#F1F1F1" />
        <SolidColorBrush x:Key="BorderDark" Color="#3F3F46" />
        <SolidColorBrush x:Key="ClipVideoBrush" Color="#2D7D9A" />
        <SolidColorBrush x:Key="ClipAudioBrush" Color="#2E8B57" />

        <converters:TimeToPixelConverter x:Key="TimeToPixelConverter" />
        <converters:DurationToWidthConverter x:Key="DurationToWidthConverter" />
        <converters:AssetTypeToBrushConverter x:Key="AssetTypeToBrushConverter" />
        <converters:AssetTypeToIconConverter x:Key="AssetTypeToIconConverter" />

        <sys:Double x:Key="SystemDouble025">0.25</sys:Double>
        <sys:Double x:Key="SystemDouble05">0.5</sys:Double>
        <sys:Double x:Key="SystemDouble10">1.0</sys:Double>
        <sys:Double x:Key="SystemDouble15">1.5</sys:Double>
        <sys:Double x:Key="SystemDouble20">2.0</sys:Double>
    </Application.Resources>
</Application>
