<Window x:Class="CutCraft.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CutCraft.Wpf.ViewModels"
        xmlns:models="clr-namespace:CutCraft.Core.Models;assembly=CutCraft.Core"
        xmlns:views="clr-namespace:CutCraft.Wpf.Views"
        mc:Ignorable="d"
        Title="CutCraft - C# Video Editor" Height="820" Width="1300"
        Background="{StaticResource BackgroundDark}"
        AutomationProperties.Name="CutCraft Video Editor Main Window">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.InputBindings>
        <!-- Accessible Keyboard Shortcuts -->
        <KeyBinding Key="Space" Command="{Binding TogglePlayPauseCommand}" />
        <KeyBinding Key="K" Command="{Binding TogglePlayPauseCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Command="{Binding SplitAtPlayheadCommand}" />
        <KeyBinding Key="I" Command="{Binding TrimStartAtPlayheadCommand}" />
        <KeyBinding Key="O" Command="{Binding TrimEndAtPlayheadCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedClipCommand}" />
        <KeyBinding Key="Left" Command="{Binding StepBackwardCommand}" />
        <KeyBinding Key="Right" Command="{Binding StepForwardCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding SelectPreviousClipCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding SelectNextClipCommand}" />
        <KeyBinding Key="Home" Command="{Binding JumpToStartCommand}" />
        <KeyBinding Key="End" Command="{Binding JumpToEndCommand}" />
        <KeyBinding Key="M" Command="{Binding AddMarkerAtPlayheadCommand}" />
        <KeyBinding Key="M" Modifiers="Alt" Command="{Binding JumpToNextMarkerCommand}" />
        <KeyBinding Key="N" Command="{Binding ToggleSnappingCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RotateSelectedClipCommand}" />
        <KeyBinding Key="R" Modifiers="Alt" Command="{Binding ToggleRippleEditModeCommand}" />
        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding RippleDeleteSelectedClipCommand}" />
        <KeyBinding Key="G" Modifiers="Alt" Command="{Binding CloseGapAtPlayheadCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Menu & Ribbon -->
            <RowDefinition Height="*" />    <!-- Workspace (Library / Captions / Inspector + Preview) -->
            <RowDefinition Height="5" />    <!-- Splitter -->
            <RowDefinition Height="330" />  <!-- Timeline Editor -->
            <RowDefinition Height="Auto" /> <!-- Accessible Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Menu & Quick Actions & Update Notification -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="10,6">
                    <Menu DockPanel.Dock="Left" Background="Transparent" Foreground="{StaticResource TextLight}" FontSize="13">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New Project" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}" />
                            <MenuItem Header="_Open Project..." InputGestureText="Ctrl+O" Click="OpenProject_Click" />
                            <MenuItem Header="_Save Project" InputGestureText="Ctrl+S" Click="SaveProject_Click" />
                            <Separator />
                            <MenuItem Header="_Export MP4..." InputGestureText="Ctrl+E" Click="Export_Click" />
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                            <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                            <Separator />
                            <MenuItem Header="_Split Clip" InputGestureText="S" Command="{Binding SplitAtPlayheadCommand}" />
                            <MenuItem Header="Set _In Point" InputGestureText="I" Command="{Binding TrimStartAtPlayheadCommand}" />
                            <MenuItem Header="Set _Out Point" InputGestureText="O" Command="{Binding TrimEndAtPlayheadCommand}" />
                            <MenuItem Header="_Delete Clip" InputGestureText="Del" Command="{Binding DeleteSelectedClipCommand}" />
                            <MenuItem Header="_Ripple Delete Clip" InputGestureText="Shift+Del" Command="{Binding RippleDeleteSelectedClipCommand}" />
                            <MenuItem Header="Toggle _Ripple Edit Mode" InputGestureText="Alt+R" Command="{Binding ToggleRippleEditModeCommand}" />
                            <MenuItem Header="_Close Gap at Playhead" InputGestureText="Alt+G" Command="{Binding CloseGapAtPlayheadCommand}" />
                            <MenuItem Header="Close _All Gaps on Track" Command="{Binding CloseAllGapsOnSelectedTrackCommand}" />
                            <Separator />
                            <MenuItem Header="_Add Marker at Playhead" InputGestureText="M" Command="{Binding AddMarkerAtPlayheadCommand}" />
                            <MenuItem Header="_Next Marker" InputGestureText="Alt+M" Command="{Binding JumpToNextMarkerCommand}" />
                            <MenuItem Header="_Previous Marker" Command="{Binding JumpToPreviousMarkerCommand}" />
                            <MenuItem Header="Toggle Magnetic _Snapping" InputGestureText="N" Command="{Binding ToggleSnappingCommand}" />
                            <MenuItem Header="_Rotate Selected Clip 90°" InputGestureText="Ctrl+R" Command="{Binding RotateSelectedClipCommand}" />
                        </MenuItem>
                        <MenuItem Header="_Speed">
                            <MenuItem Header="0.25x Slow Motion" Command="{Binding ChangeSpeedCommand}" CommandParameter="{StaticResource SystemDouble025}" />
                            <MenuItem Header="0.5x Slow Motion" Command="{Binding ChangeSpeedCommand}" CommandParameter="{StaticResource SystemDouble05}" />
                            <MenuItem Header="1.0x Normal Speed" Command="{Binding ChangeSpeedCommand}" CommandParameter="{StaticResource SystemDouble10}" />
                            <MenuItem Header="1.5x Fast Motion" Command="{Binding ChangeSpeedCommand}" CommandParameter="{StaticResource SystemDouble15}" />
                            <MenuItem Header="2.0x Double Speed" Command="{Binding ChangeSpeedCommand}" CommandParameter="{StaticResource SystemDouble20}" />
                        </MenuItem>
                        <MenuItem Header="_Audio">
                            <MenuItem Header="_Add Music at Current Position..." InputGestureText="Ctrl+M" Click="AddMusicAtPlayhead_Click" />
                            <MenuItem Header="_Place Selected Media at Current Position" Command="{Binding AddSelectedAssetAtPlayheadCommand}" />
                            <MenuItem Header="_Move Selected Clip to Current Position" Command="{Binding MoveSelectedClipToPlayheadCommand}" />
                            <Separator />
                            <MenuItem Header="_Detach Audio to Track" Command="{Binding DetachAudioCommand}" />
                        </MenuItem>
                        <MenuItem Header="_Captions">
                            <MenuItem Header="_Add Caption at Playhead" Command="{Binding AddCaptionCommand}" />
                            <MenuItem Header="_Validate Subtitles" Command="{Binding ValidateSubtitlesCommand}" />
                            <MenuItem Header="Shift Subtitles _Earlier (-0.5s)" Command="{Binding ShiftCaptionsEarlierCommand}" />
                            <MenuItem Header="Shift Subtitles _Later (+0.5s)" Command="{Binding ShiftCaptionsLaterCommand}" />
                            <Separator />
                            <MenuItem Header="_Import Subtitles (.SRT / .VTT)..." Click="ImportSrt_Click" />
                            <MenuItem Header="_Export Subtitles (.SRT / .VTT)..." Click="ExportSrt_Click" />
                        </MenuItem>
                        <MenuItem Header="_Titles">
                            <MenuItem Header="Add _Lower Third Card" Command="{Binding AddLowerThirdPresetCommand}" />
                            <MenuItem Header="Add _Cinematic Header Card" Command="{Binding AddCinematicHeaderPresetCommand}" />
                            <MenuItem Header="Add _Bold Headline Banner" Command="{Binding AddBoldHeadlinePresetCommand}" />
                            <MenuItem Header="Add _Minimalist Title" Command="{Binding AddMinimalistPresetCommand}" />
                            <MenuItem Header="Add _Neon Cyber Glow" Command="{Binding AddNeonGlowPresetCommand}" />
                            <MenuItem Header="Add _Vintage Retro Title" Command="{Binding AddVintageRetroPresetCommand}" />
                        </MenuItem>
                        <MenuItem Header="_Settings" AutomationProperties.Name="Settings Menu">
                            <MenuItem Header="_Automatically Check for Updates on Startup"
                                      AutomationProperties.Name="Automatically Check for Updates on Startup">
                                <MenuItem Header="_Enabled" IsCheckable="True" IsChecked="{Binding IsAutoCheckUpdatesEnabled, Mode=OneWay}"
                                          Command="{Binding SetAutoCheckUpdatesCommand}" CommandParameter="Enabled"
                                          AutomationProperties.Name="Enable Automatic Update Check on Startup" />
                                <MenuItem Header="_Disabled" IsCheckable="True" IsChecked="{Binding IsAutoCheckUpdatesDisabled, Mode=OneWay}"
                                          Command="{Binding SetAutoCheckUpdatesCommand}" CommandParameter="Disabled"
                                          AutomationProperties.Name="Disable Automatic Update Check on Startup" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Check for _Updates..." Command="{Binding ManualCheckForUpdatesCommand}"
                                      AutomationProperties.Name="Check for Updates Now" />
                        </MenuItem>
                        <MenuItem Header="_Help" AutomationProperties.Name="Help Menu">
                            <MenuItem Header="Check for _Updates..." Command="{Binding ManualCheckForUpdatesCommand}"
                                      AutomationProperties.Name="Check for CutCraft Updates" />
                            <MenuItem Header="_About CutCraft" Command="{Binding ShowAboutCommand}"
                                      AutomationProperties.Name="About CutCraft" />
                        </MenuItem>
                    </Menu>

                    <!-- Quick Action Buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="↩ Undo" Command="{Binding UndoCommand}" Margin="4,0" Padding="8,4"
                                AutomationProperties.Name="Undo action (Ctrl+Z)"
                                Background="#333337" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" />
                        <Button Content="↪ Redo" Command="{Binding RedoCommand}" Margin="4,0" Padding="8,4"
                                AutomationProperties.Name="Redo action (Ctrl+Y)"
                                Background="#333337" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" />
                        <Button Content="✂ Split (S)" Command="{Binding SplitAtPlayheadCommand}" Margin="8,0,4,0" Padding="12,4"
                                AutomationProperties.Name="Split clip at playhead position (Shortcut S)"
                                Background="{StaticResource AccentColor}" Foreground="{StaticResource TextLight}" FontWeight="SemiBold" />
                        <Button Content="▶ Export MP4" Margin="4,0" Padding="12,4" Click="Export_Click"
                                AutomationProperties.Name="Export project as MP4 video file"
                                Background="#2E8B57" Foreground="{StaticResource TextLight}" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>

                <!-- Accessible Update Notification Bar (Keyboard & NVDA Accessible) -->
                <Border Visibility="{Binding UpdateNotificationVisibility}"
                        Background="#16222F" BorderBrush="#0078D7" BorderThickness="0,1,0,2" Padding="14,10"
                        AutomationProperties.Name="CutCraft Update Notification"
                        AutomationProperties.LiveSetting="Assertive">
                    <DockPanel LastChildFill="True">
                        <!-- Action Buttons Section (Right) -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <!-- Update Available Options: 1. Download and Install, 2. Remind Me Later, 3. Skip This Version -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding UpdateActionButtonsVisibility}">
                                <Button Content="_Download and Install" Command="{Binding DownloadAndInstallUpdateCommand}"
                                        AutomationProperties.Name="Download and Install CutCraft update"
                                        AutomationProperties.HelpText="Downloads update package and restarts CutCraft to install"
                                        Background="#0078D7" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0"
                                        Cursor="Hand" />
                                <Button Content="_Remind Me Later" Command="{Binding RemindMeLaterCommand}"
                                        AutomationProperties.Name="Remind Me Later about this update"
                                        AutomationProperties.HelpText="Postpones update notification until next startup"
                                        Background="#2D2D30" Foreground="{StaticResource TextLight}" Padding="10,6" Margin="0,0,8,0"
                                        Cursor="Hand" />
                                <Button Content="_Skip This Version" Command="{Binding SkipThisVersionCommand}"
                                        AutomationProperties.Name="Skip this version and do not notify again"
                                        AutomationProperties.HelpText="Skips this update version entirely"
                                        Background="#2D2D30" Foreground="#FFA500" Padding="10,6"
                                        Cursor="Hand" />
                            </StackPanel>

                            <!-- Dismiss Button for Up to Date or Error notifications -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding UpToDateOrErrorDismissVisibility}">
                                <Button Content="_OK" Command="{Binding CloseUpdateNotificationCommand}"
                                        AutomationProperties.Name="Dismiss notification"
                                        Background="#0078D7" Foreground="White" FontWeight="SemiBold" Padding="16,6"
                                        Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Download Progress Bar (When downloading) -->
                        <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding DownloadProgressVisibility}" Margin="0,8,0,0">
                            <ProgressBar Value="{Binding DownloadProgressPercent}" Maximum="100" Height="8"
                                         Background="#252526" Foreground="#00BCF9" BorderBrush="#00BCF9"
                                         AutomationProperties.Name="Update Download Progress Bar" />
                            <TextBlock Text="{Binding DownloadProgressText}" Foreground="#00BCF9" FontSize="11" Margin="0,4,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="{Binding DownloadProgressText}" />
                        </StackPanel>

                        <!-- Information Text -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateNotificationTitle}" Foreground="White" FontWeight="Bold" FontSize="13"
                                       AutomationProperties.Name="Update Notification Title" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="Installed Version: " Foreground="#AAAAAA" FontSize="11" />
                                <TextBlock Text="{Binding InstalledVersionDisplay}" Foreground="White" FontWeight="SemiBold" FontSize="11" Margin="0,0,14,0" />
                                <TextBlock Text="Latest Available: " Foreground="#AAAAAA" FontSize="11" />
                                <TextBlock Text="{Binding LatestVersionDisplay}" Foreground="#00BCF9" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateNotificationMessage}" Foreground="#E0E0E0" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                       AutomationProperties.Name="Update Status Details" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Center Workspace: Left = Tabs (Media Library, Captions, Clip Inspector), Right = Video Preview -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tabs -->
            <TabControl Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderDark}">
                <!-- Tab 1: Media Library -->
                <TabItem Header="Media Library" Background="#2A2A2D" Foreground="{StaticResource TextLight}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" ItemsSource="{Binding CurrentProject.MediaLibrary}" SelectedItem="{Binding SelectedAsset}"
                                 Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                                 AutomationProperties.Name="Media Library Assets List">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <Border Width="36" Height="36" Background="#333337" CornerRadius="3" Margin="0,0,8,0">
                                            <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentColor}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{StaticResource TextLight}" />
                                            <TextBlock Text="{Binding Duration, StringFormat='Duration: {0:mm\\:ss}'}" FontSize="11" Foreground="#AAAAAA" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button Content="🎵 + Add Music at Current Point..." Margin="0,0,0,4" Padding="10,6"
                                    Click="AddMusicAtPlayhead_Click" AutomationProperties.Name="Select and add music at current playhead position (Ctrl+M)"
                                    Background="#2E8B57" Foreground="{StaticResource TextLight}" FontWeight="SemiBold" BorderBrush="{StaticResource BorderDark}" />
                            <Button Content="📍 Place Selected Asset at Current Point" Margin="0,0,0,4" Padding="10,5"
                                    Command="{Binding AddSelectedAssetAtPlayheadCommand}" AutomationProperties.Name="Place selected media asset at current playhead position"
                                    Background="#333337" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" />
                            <Button Content="+ Import Media Files..." Padding="10,5"
                                    Click="ImportMedia_Click" AutomationProperties.Name="Import video, audio, or image files"
                                    Background="#2D2D30" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Captions & Subtitles (.SRT / .VTT) -->
                <TabItem Header="Captions (.SRT / .VTT)" Background="#2A2A2D" Foreground="{StaticResource TextLight}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Caption Quick Actions Toolbar -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button Content="+ Add at Playhead" Command="{Binding AddCaptionCommand}" Padding="8,4" Margin="2"
                                    Background="{StaticResource AccentColor}" Foreground="{StaticResource TextLight}"
                                    AutomationProperties.Name="Add new caption at playhead" />
                            <Button Content="✂ Split" Command="{Binding SplitSelectedCaptionAtPlayheadCommand}" Padding="6,4" Margin="2"
                                    Background="#333337" Foreground="{StaticResource TextLight}"
                                    AutomationProperties.Name="Split selected caption at current playhead" />
                            <Button Content="🔗 Merge Next" Command="{Binding MergeSelectedCaptionWithNextCommand}" Padding="6,4" Margin="2"
                                    Background="#333337" Foreground="{StaticResource TextLight}"
                                    AutomationProperties.Name="Merge selected caption with next caption" />
                            <Button Content="⏪ -0.5s" Command="{Binding ShiftCaptionsEarlierCommand}" Padding="6,4" Margin="2"
                                    Background="#333337" Foreground="{StaticResource TextLight}"
                                    AutomationProperties.Name="Shift all captions earlier by 0.5s" />
                            <Button Content="⏩ +0.5s" Command="{Binding ShiftCaptionsLaterCommand}" Padding="6,4" Margin="2"
                                    Background="#333337" Foreground="{StaticResource TextLight}"
                                    AutomationProperties.Name="Shift all captions later by 0.5s" />
                            <Button Content="🔍 Validate" Command="{Binding ValidateSubtitlesCommand}" Padding="6,4" Margin="2"
                                    Background="#2E8B57" Foreground="{StaticResource TextLight}"
                                    AutomationProperties.Name="Validate subtitles timing and reading speed" />
                            <Button Content="📂 Import" Click="ImportSrt_Click" Padding="6,4" Margin="2"
                                    Background="#2D2D30" Foreground="{StaticResource TextLight}"
                                    AutomationProperties.Name="Import subtitle file in SRT or VTT format" />
                            <Button Content="💾 Export" Click="ExportSrt_Click" Padding="6,4" Margin="2"
                                    Background="#2D2D30" Foreground="{StaticResource TextLight}"
                                    AutomationProperties.Name="Export subtitle file in SRT or VTT format" />
                        </WrapPanel>

                        <!-- Captions List -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding CurrentProject.Captions}" SelectedItem="{Binding SelectedCaption}"
                                 Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                                 AutomationProperties.Name="Project Captions List">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0}'}"
                                                       Foreground="#888888" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                                            <StackPanel Grid.Column="1" Margin="4,0">
                                                <TextBlock Text="{Binding Text}" FontWeight="Medium" Foreground="{StaticResource TextLight}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding StartTime, StringFormat='{}{0:mm\\:ss\\.fff}'}" FontSize="11" Foreground="#00BCF9" />
                                                    <TextBlock Text=" ➔ " FontSize="11" Foreground="#666666" />
                                                    <TextBlock Text="{Binding EndTime, StringFormat='{}{0:mm\\:ss\\.fff}'}" FontSize="11" Foreground="#00BCF9" />
                                                    <TextBlock Text="{Binding Duration.TotalSeconds, StringFormat=' ({0:F1}s)'}" FontSize="11" Foreground="#888888" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="⚡ FAST" FontSize="9" Foreground="#FFA500" FontWeight="Bold"
                                                           Visibility="{Binding HasReadingSpeedWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           ToolTip="Reading speed exceeds recommended 26 chars/sec" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected Caption Editor -->
                        <Border Grid.Row="2" Background="#252528" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Caption Editor" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Speaker: " Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding CaptionEditorSpeaker, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" Padding="4,2" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="Style: " Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox Grid.Column="3" SelectedItem="{Binding CaptionEditorStyle}" Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}">
                                        <models:CaptionStylePreset>Default</models:CaptionStylePreset>
                                        <models:CaptionStylePreset>YellowCinema</models:CaptionStylePreset>
                                        <models:CaptionStylePreset>HighContrastWhite</models:CaptionStylePreset>
                                        <models:CaptionStylePreset>BoxedDark</models:CaptionStylePreset>
                                        <models:CaptionStylePreset>TopHeader</models:CaptionStylePreset>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="Subtitle Text:" Foreground="#AAAAAA" FontSize="11" Margin="0,2,0,2" />
                                <TextBox Text="{Binding CaptionEditorText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="48" Padding="4"
                                         AutomationProperties.Name="Selected caption text editor" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Start (sec):" Foreground="#AAAAAA" FontSize="10" />
                                        <TextBox Text="{Binding CaptionEditorStartSeconds, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" Padding="3,2" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0">
                                        <TextBlock Text="End (sec):" Foreground="#AAAAAA" FontSize="10" />
                                        <TextBox Text="{Binding CaptionEditorEndSeconds, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" Padding="3,2" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,0">
                                        <Button Content="Save" Command="{Binding CommitCaptionEditCommand}" Padding="10,4" Margin="0,0,4,0"
                                                Background="{StaticResource AccentColor}" Foreground="{StaticResource TextLight}" FontWeight="SemiBold"
                                                AutomationProperties.Name="Save changes to selected caption" />
                                        <Button Content="Delete" Command="{Binding RemoveSelectedCaptionCommand}" Padding="8,4"
                                                Background="#C0392B" Foreground="{StaticResource TextLight}"
                                                AutomationProperties.Name="Delete selected caption" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SubtitleValidationSummary}" Margin="0,6,0,0"
                                           Foreground="#00FF66" FontSize="11" TextWrapping="Wrap"
                                           Visibility="{Binding SubtitleValidationSummary, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 3: Titles & Overlays (Stylized Title Cards) -->
                <TabItem Header="Titles &amp; Overlays" Background="#2A2A2D" Foreground="{StaticResource TextLight}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Presets Bar -->
                        <Border Grid.Row="0" Background="#222225" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Quick Title Presets (Add at Playhead):" FontSize="11" FontWeight="SemiBold" Foreground="#00BCF9" Margin="0,0,0,4" />
                                <WrapPanel>
                                    <Button Content="🎬 Lower Third" Command="{Binding AddLowerThirdPresetCommand}" Padding="6,3" Margin="2" Background="#1E293B" Foreground="#00BCF9" BorderBrush="#00BCF9" />
                                    <Button Content="👑 Cinematic Title" Command="{Binding AddCinematicHeaderPresetCommand}" Padding="6,3" Margin="2" Background="#2B2117" Foreground="#F5E6C8" BorderBrush="#D4AF37" />
                                    <Button Content="💥 Bold Headline" Command="{Binding AddBoldHeadlinePresetCommand}" Padding="6,3" Margin="2" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#FFCC00" />
                                    <Button Content="✨ Minimalist" Command="{Binding AddMinimalistPresetCommand}" Padding="6,3" Margin="2" Background="#2D2D30" Foreground="#E2E8F0" />
                                    <Button Content="⚡ Neon Glow" Command="{Binding AddNeonGlowPresetCommand}" Padding="6,3" Margin="2" Background="#050814" Foreground="#00F0FF" BorderBrush="#FF007F" />
                                    <Button Content="📜 Vintage Retro" Command="{Binding AddVintageRetroPresetCommand}" Padding="6,3" Margin="2" Background="#2B1B17" Foreground="#FFE0B2" BorderBrush="#B8860B" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Overlays List -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding CurrentProject.Overlays}" SelectedItem="{Binding SelectedOverlay}"
                                 Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                                 AutomationProperties.Name="Project Text Overlays List">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Text}" FontWeight="Bold" Foreground="{StaticResource TextLight}" />
                                                <TextBlock Text="{Binding SubtitleText}" FontSize="11" Foreground="#00BCF9"
                                                           Visibility="{Binding SubtitleText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Style, StringFormat='[{0}] '}" FontSize="10" Foreground="#FFA500" />
                                                    <TextBlock Text="{Binding Animation, StringFormat='Anim: {0} | '}" FontSize="10" Foreground="#888888" />
                                                    <TextBlock Text="{Binding StartTime, StringFormat='At: {0:mm\\:ss\\.f}'}" FontSize="10" Foreground="#AAAAAA" />
                                                    <TextBlock Text="{Binding Duration.TotalSeconds, StringFormat=' ({0:F1}s)'}" FontSize="10" Foreground="#888888" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="✦" Foreground="{StaticResource AccentColor}" FontSize="14" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected Overlay Inspector -->
                        <Border Grid.Row="2" Background="#252528" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Title Card Inspector" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Title: " Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding OverlayEditorText, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" Padding="4,2" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="Subtitle: " Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="3" Text="{Binding OverlayEditorSubtitle, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" Padding="4,2" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Animation:" Foreground="#AAAAAA" FontSize="10" />
                                        <ComboBox SelectedItem="{Binding OverlayEditorAnimation}" Background="#1E1E1E" Foreground="{StaticResource TextLight}">
                                            <models:TextAnimationType>Fade</models:TextAnimationType>
                                            <models:TextAnimationType>SlideUp</models:TextAnimationType>
                                            <models:TextAnimationType>SlideLeft</models:TextAnimationType>
                                            <models:TextAnimationType>ZoomIn</models:TextAnimationType>
                                            <models:TextAnimationType>None</models:TextAnimationType>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="2,0">
                                        <TextBlock Text="Font Size:" Foreground="#AAAAAA" FontSize="10" />
                                        <TextBox Text="{Binding OverlayEditorFontSize, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" Padding="3,2" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="Duration (s):" Foreground="#AAAAAA" FontSize="10" />
                                        <TextBox Text="{Binding OverlayEditorDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" Padding="3,2" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Content="Lower 3rd" Command="{Binding ApplyLowerThirdPresetCommand}" Padding="4,2" Margin="0,0,2,0" Background="#1E293B" Foreground="#00BCF9" FontSize="10" />
                                        <Button Content="Cinema" Command="{Binding ApplyCinematicHeaderPresetCommand}" Padding="4,2" Margin="2,0" Background="#2B2117" Foreground="#F5E6C8" FontSize="10" />
                                        <Button Content="Headline" Command="{Binding ApplyBoldHeadlinePresetCommand}" Padding="4,2" Margin="2,0" Background="#0F172A" Foreground="#FFFFFF" FontSize="10" />
                                        <Button Content="Neon" Command="{Binding ApplyNeonGlowPresetCommand}" Padding="4,2" Margin="2,0" Background="#050814" Foreground="#00F0FF" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Duplicate" Command="{Binding DuplicateSelectedOverlayCommand}" Padding="6,3" Margin="0,0,4,0" Background="#333337" Foreground="{StaticResource TextLight}" />
                                        <Button Content="Save" Command="{Binding CommitOverlayEditCommand}" Padding="8,3" Margin="0,0,4,0" Background="{StaticResource AccentColor}" Foreground="{StaticResource TextLight}" FontWeight="SemiBold" />
                                        <Button Content="Delete" Command="{Binding RemoveSelectedOverlayCommand}" Padding="6,3" Background="#C0392B" Foreground="{StaticResource TextLight}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 4: Clip Inspector & Properties -->
                <TabItem Header="Clip Properties" Background="#2A2A2D" Foreground="{StaticResource TextLight}">
                    <views:ClipPropertiesPanel DataContext="{Binding}" />
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Video Preview Player Panel -->
            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Viewport Screen -->
                    <Border Grid.Row="0" Background="#0A0A0A" Margin="8" CornerRadius="3" ClipToBounds="True">
                        <Grid x:Name="PreviewContainer">
                            <!-- MediaElement Video Player -->
                            <MediaElement x:Name="VideoPreviewElement"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />

                            <!-- Placeholder when no video clip is active -->
                            <Grid Visibility="{Binding HasActiveVideo, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🎬" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.4" />
                                    <TextBlock Text="{Binding PreviewOverlayMessage}" HorizontalAlignment="Center"
                                               Foreground="#777777" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Import a video clip or press [Space] to play timeline" HorizontalAlignment="Center"
                                               Foreground="#555555" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Subtitles / Captions Live Burn-In Display -->
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,28"
                                    Background="#CC000000" CornerRadius="4" Padding="14,6"
                                    Visibility="{Binding ActiveCaptionVisibility}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveCaptionText}"
                                               Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Animated Title Cards & Text Overlays Live Display -->
                            <Grid Visibility="{Binding ActiveOverlayVisibility}" IsHitTestVisible="False" Margin="30,24">
                                <Border HorizontalAlignment="{Binding ActiveOverlayHorizontalAlignment}"
                                        VerticalAlignment="{Binding ActiveOverlayVerticalAlignment}"
                                        Background="{Binding ActiveOverlayBackground, Converter={StaticResource HexToBrushConverter}}"
                                        BorderBrush="{Binding ActiveOverlayBorder, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="{Binding ActiveOverlayBorderWidth}"
                                        CornerRadius="4" Padding="18,10"
                                        Opacity="{Binding ActiveOverlayOpacity}">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="{Binding ActiveOverlayTranslateX}" Y="{Binding ActiveOverlayTranslateY}" />
                                    </Border.RenderTransform>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveOverlayText}"
                                                   Foreground="{Binding ActiveOverlayColor, Converter={StaticResource HexToBrushConverter}, ConverterParameter='#FFFFFFFF'}"
                                                   FontFamily="{Binding ActiveOverlayFont}"
                                                   FontSize="{Binding ActiveOverlayFontSize}"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ActiveOverlaySubtitle}"
                                                   Foreground="#00BCF9"
                                                   FontFamily="{Binding ActiveOverlayFont}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding ActiveOverlaySubtitle, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Top-Right Timecode Display Overlay -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                    Background="#AA000000" CornerRadius="3" Padding="8,4">
                                <TextBlock Text="{Binding CurrentTimecode}" Foreground="{StaticResource AccentColor}"
                                           FontSize="18" FontWeight="Bold" FontFamily="Consolas"
                                           AutomationProperties.Name="Current Timecode Display" />
                            </Border>

                            <!-- Top-Left Playback State Indicator -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                    Background="#AA000000" CornerRadius="3" Padding="6,3"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="▶ PLAYING" Foreground="#00FF66" FontSize="11" FontWeight="Bold" FontFamily="Consolas" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Player Transport Controls -->
                    <Border Grid.Row="1" Background="#1E1E1E" Padding="12,8" Margin="8,0,8,8" CornerRadius="3">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="⏮" Command="{Binding StepBackwardCommand}" Width="36" Height="32" Margin="2,0"
                                        AutomationProperties.Name="Step back one frame (Left Arrow)" />
                                <Button Content="{Binding PlayPauseButtonText}" Command="{Binding TogglePlayPauseCommand}"
                                        Width="80" Height="32" Margin="4,0" Background="{StaticResource AccentColor}"
                                        Foreground="{StaticResource TextLight}" FontWeight="Bold"
                                        AutomationProperties.Name="Play or pause video (Space)" />
                                <Button Content="⏭" Command="{Binding StepForwardCommand}" Width="36" Height="32" Margin="2,0"
                                        AutomationProperties.Name="Step forward one frame (Right Arrow)" />
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentTimecode}" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" Margin="12,0,4,0" />

                            <Slider VerticalAlignment="Center" Margin="12,0" Minimum="0"
                                    Maximum="{Binding CurrentProject.Duration.TotalSeconds}"
                                    Value="{Binding PlayheadSeconds}"
                                    AutomationProperties.Name="Timeline Playhead Scrubber" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="{StaticResource BorderDark}" />

        <!-- Bottom Timeline Editor -->
        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Timeline Toolbar & Time Ruler -->
                    <RowDefinition Height="*" />    <!-- Tracks Container -->
                </Grid.RowDefinitions>

                <!-- Timeline Header & Shortcuts Info -->
                <DockPanel Grid.Row="0" Margin="10,6" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="Timeline Tracks" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" />
                        <TextBlock Text=" • [S] Split | [I] Set In | [O] Set Out | [Alt+Arrows] Prev/Next Clip" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Content="🎵 Add Music at Point" Click="AddMusicAtPlayhead_Click" Margin="12,0,4,0" Padding="8,3"
                                Background="#2E8B57" Foreground="{StaticResource TextLight}" FontWeight="SemiBold"
                                AutomationProperties.Name="Add music at current playhead position (Ctrl+M)" />
                        <Button Content="📍 + Marker (M)" Command="{Binding AddMarkerAtPlayheadCommand}" Margin="4,0" Padding="8,3"
                                Background="#333337" Foreground="#FFCC00" FontWeight="SemiBold" BorderBrush="{StaticResource BorderDark}"
                                AutomationProperties.Name="Add marker at playhead position (Shortcut M)" />
                        <Button Content="🧲 Snap" Command="{Binding ToggleSnappingCommand}" Margin="4,0" Padding="8,3"
                                Background="#333337" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                                ToolTip="Toggle magnetic snapping to cuts and markers (Shortcut N)"
                                AutomationProperties.Name="Toggle magnetic snapping" />
                        <Button Content="{Binding RippleModeButtonText}" Command="{Binding ToggleRippleEditModeCommand}" Margin="4,0" Padding="8,3"
                                Background="#2A3B4C" Foreground="#00BCF9" FontWeight="SemiBold" BorderBrush="{StaticResource BorderDark}"
                                ToolTip="Toggle Ripple Edit Mode (Alt+R). When ON, deletes and trims ripple subsequent clips automatically"
                                AutomationProperties.Name="Toggle Ripple Edit Mode" />
                        <Button Content="🌊 Ripple Del" Command="{Binding RippleDeleteSelectedClipCommand}" Margin="4,0" Padding="8,3"
                                Background="#3A2A2D" Foreground="#FF9999" BorderBrush="{StaticResource BorderDark}"
                                ToolTip="Ripple delete selected clip and close gap (Shift+Delete)"
                                AutomationProperties.Name="Ripple Delete Selected Clip" />
                        <Button Content="🧲 Close Gap" Command="{Binding CloseGapAtPlayheadCommand}" Margin="4,0" Padding="8,3"
                                Background="#333337" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                                ToolTip="Close blank gap at playhead (Alt+G)"
                                AutomationProperties.Name="Close Blank Gap at Playhead" />
                        <Button Content="Auto-Pack" Command="{Binding CloseAllGapsOnSelectedTrackCommand}" Margin="4,0" Padding="8,3"
                                Background="#333337" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                                ToolTip="Close all gaps on track sequentially"
                                AutomationProperties.Name="Close all gaps on track" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Zoom:" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Width="100" Minimum="20" Maximum="300" Value="{Binding ZoomLevel}" VerticalAlignment="Center"
                                AutomationProperties.Name="Timeline Zoom Level" />
                    </StackPanel>
                </DockPanel>

                <!-- Tracks List and Clips -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CurrentProject.Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="72" Background="#1B1B1C" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" /> <!-- Track Header -->
                                            <ColumnDefinition Width="*" />   <!-- Track Clips Canvas -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Track Header -->
                                        <Border Grid.Column="0" Background="#222224" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Padding="8,4">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextLight}" />
                                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#AAAAAA" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Clips Horizontal Sequence -->
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Clips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Height="64" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding TimelineStart, Converter={StaticResource TimeToPixelConverter}}" />
                                                    <Setter Property="Canvas.Top" Value="4" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="56" MinWidth="60" Width="{Binding TimelineDuration, Converter={StaticResource DurationToWidthConverter}}"
                                                            Background="{Binding Type, Converter={StaticResource AssetTypeToBrushConverter}}"
                                                            BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,4"
                                                            MouseLeftButtonDown="Clip_MouseLeftButtonDown" Cursor="Hand"
                                                            AutomationProperties.Name="{Binding Name, StringFormat='Clip: {0}'}"
                                                            AutomationProperties.HelpText="Click to select. Press S to split, I for In-point, O for Out-point">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Type, Converter={StaticResource AssetTypeToIconConverter}}" FontSize="11" Margin="0,0,3,0" />
                                                                <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding TimelineDuration, StringFormat='{}{0:mm\\:ss\\.f}'}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                       FontSize="10" Foreground="#DDDDDD" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom Accessible Status Bar (Screen Reader Live Region) -->
        <Border Grid.Row="4" Background="#0E0E0E" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding UpdateButtonText}" Command="{Binding ManualCheckForUpdatesCommand}"
                            AutomationProperties.Name="{Binding UpdateButtonAccessibleText}"
                            Margin="8,0,0,0" Padding="8,2" FontSize="11"
                            Background="#252526" Foreground="#00BCF9" BorderBrush="#3F3F46"
                            Cursor="Hand" ToolTip="Click to check for CutCraft updates" />
                    <TextBlock Text="{Binding CurrentProject.Duration, StringFormat='Total Duration: {0:hh\\:mm\\:ss}'}"
                               Foreground="#AAAAAA" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding AccessibilityStatus}" Foreground="#00BCF9" FontSize="12" FontWeight="Medium"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="Screen Reader Live Announcement Status" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
