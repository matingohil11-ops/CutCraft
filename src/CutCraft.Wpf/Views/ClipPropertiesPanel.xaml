<UserControl x:Class="CutCraft.Wpf.Views.ClipPropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CutCraft.Wpf.ViewModels"
             xmlns:models="clr-namespace:CutCraft.Core.Models;assembly=CutCraft.Core"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300"
             Background="{StaticResource PanelBackground}"
             AutomationProperties.Name="Clip Properties and Effects Panel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" DataContext="{Binding SelectedClip}">
            <!-- Header -->
            <TextBlock Text="Clip Properties" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextLight}" Margin="0,0,0,12" />

            <Border Background="#1E1E1E" Padding="10" CornerRadius="4" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Clip Name" Foreground="#AAAAAA" FontSize="11" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="#2D2D30" Foreground="{StaticResource TextLight}"
                             BorderBrush="{StaticResource BorderDark}" Margin="0,4,0,8" Padding="4"
                             AutomationProperties.Name="Selected clip name editor" />

                    <TextBlock Text="{Binding Type, StringFormat='Type: {0}'}" Foreground="#00BCF9" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding TimelineDuration, StringFormat='Duration: {0:mm\\:ss\\.fff}'}" Foreground="{StaticResource TextLight}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding TimelineStart, StringFormat='Timeline Start: {0:mm\\:ss\\.fff}'}" Foreground="#FFD700" FontSize="12" Margin="0,0,0,6" />
                    <Button Content="📍 Align to Current Playhead"
                            Command="{Binding DataContext.MoveSelectedClipToPlayheadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Padding="6,4" Background="#333337" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}"
                            AutomationProperties.Name="Move selected clip start point to current playhead position" />
                </StackPanel>
            </Border>

            <!-- Playback Speed -->
            <TextBlock Text="Playback Speed" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" Margin="0,4,0,4" />
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Speed, StringFormat='{}{0:0.00}x'}" Foreground="{StaticResource AccentColor}" Width="45" TextAlignment="Right" />
                <Slider Minimum="0.25" Maximum="4.0" Value="{Binding Speed}" SmallChange="0.25" LargeChange="0.5"
                        AutomationProperties.Name="Clip playback speed slider" />
            </DockPanel>

            <!-- Audio Volume -->
            <TextBlock Text="Audio Volume" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" Margin="0,4,0,4" />
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Volume, StringFormat='{}{0:0%}'}" Foreground="{StaticResource AccentColor}" Width="45" TextAlignment="Right" />
                <Slider Minimum="0.0" Maximum="2.0" Value="{Binding Volume}" SmallChange="0.05"
                        AutomationProperties.Name="Clip audio volume slider" />
            </DockPanel>

            <!-- Transitions -->
            <TextBlock Text="Transition In" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" Margin="0,4,0,4" />
            <ComboBox SelectedValue="{Binding TransitionIn.Type}" SelectedValuePath="Tag" Background="#2D2D30" Foreground="{StaticResource TextLight}" Margin="0,0,0,12"
                      AutomationProperties.Name="Clip transition in selector">
                <ComboBoxItem Content="None" Tag="{x:Static models:TransitionType.None}" />
                <ComboBoxItem Content="CrossFade" Tag="{x:Static models:TransitionType.CrossFade}" />
                <ComboBoxItem Content="Fade To Black" Tag="{x:Static models:TransitionType.FadeToBlack}" />
                <ComboBoxItem Content="Fade To White" Tag="{x:Static models:TransitionType.FadeToWhite}" />
                <ComboBoxItem Content="Wipe Left" Tag="{x:Static models:TransitionType.WipeLeft}" />
                <ComboBoxItem Content="Wipe Right" Tag="{x:Static models:TransitionType.WipeRight}" />
                <ComboBoxItem Content="Dissolve" Tag="{x:Static models:TransitionType.Dissolve}" />
            </ComboBox>

            <!-- Picture in Picture (PiP) & Scaling -->
            <TextBlock Text="Picture-in-Picture (PiP) Overlay" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" Margin="0,4,0,4" />
            <Border Background="#1E1E1E" Padding="10" CornerRadius="4" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Scale" Foreground="#AAAAAA" FontSize="11" />
                    <DockPanel Margin="0,2,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Scale, StringFormat='{}{0:0%}'}" Foreground="{StaticResource AccentColor}" Width="40" TextAlignment="Right" />
                        <Slider Minimum="0.1" Maximum="1.0" Value="{Binding Scale}" AutomationProperties.Name="Overlay scale slider" />
                    </DockPanel>

                    <TextBlock Text="Position X" Foreground="#AAAAAA" FontSize="11" />
                    <Slider Minimum="0.0" Maximum="1.0" Value="{Binding PositionX}" Margin="0,2,0,8" AutomationProperties.Name="Overlay horizontal position slider" />

                    <TextBlock Text="Position Y" Foreground="#AAAAAA" FontSize="11" />
                    <Slider Minimum="0.0" Maximum="1.0" Value="{Binding PositionY}" Margin="0,2,0,4" AutomationProperties.Name="Overlay vertical position slider" />
                </StackPanel>
            </Border>

            <!-- Visual Filters Summary -->
            <TextBlock Text="Applied Effects" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" Margin="0,4,0,4" />
            <ListBox ItemsSource="{Binding Effects}" Background="#1E1E1E" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BorderDark}" Height="90"
                     AutomationProperties.Name="Applied clip effects list">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Type, StringFormat='• {0}'}" FontSize="12" Margin="2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
